includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    paths:
        - app
        - Modules
        - routes
        - database
        - config

    level: 9

    excludePaths:
        - */Database/Migrations/*
        - */database/migrations/*
        - */database/seeders/*
        - */database/factories/*
        # Подключаемые модули других приложений на общем бэке (см. CLAUDE.md — каждое
        # приложение регистрирует свои роуты из своего провайдера) — не то, что ведём в
        # рамках этой работы; TrainingDiary сканируется как обычно.
        - Modules/MyCar/*
        - Modules/Nutrition/*
        - Modules/TripSplit/*
